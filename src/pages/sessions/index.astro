---
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import SessionsGrid from "../../components/SessionsGrid.astro";
import { sessionLabels, siteConfig } from "../../site-config";
import { withBase } from "astro-theme-university/url";
---

<ContentLayout
  title={sessionLabels.plural}
  description={`Two in-person workshops early in the semester, supplementary to the twelve-week lecture schedule.`}
  {...siteConfig}
>
  <p>
    These two sessions run in-person before assessment work begins: Week 1
    sets the semester's guiding question against a match you already know,
    and Week 2 puts your answer in front of another pair of eyes. From Week 3
    onward, that same standard of evidence is what each lecture and
    assessment holds you to — see the full <a href={withBase("/lectures/")}>twelve-week
    lecture schedule</a> for the rest of the semester.
  </p>
  <SessionsGrid />
</ContentLayout>
